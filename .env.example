# Backend API URLs
BASE_URL_LOCAL=http://127.0.0.1:8000
BASE_URL_PRODUCTION=https://your-production-api.com

# Public frontend origin and optional search-engine ownership verification
NEXT_PUBLIC_SITE_URL=https://md.agbedus.com
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# NextAuth
AUTH_SECRET=your-auth-secret-here

# Pip AI Assistant (NVIDIA NIM only; models are tried left-to-right)
NVIDIA_BUILD_API_KEY=your-nvidia-api-key
PIP_NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b,z-ai/glm-5.2,minimaxai/minimax-m3,deepseek-ai/deepseek-v4-pro
PIP_CONNECT_TIMEOUT_MS=20000
PIP_FIRST_TOKEN_TIMEOUT_MS=25000
PIP_STREAM_IDLE_TIMEOUT_MS=60000

# Public (client-side) API URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PRODUCTION_URL=https://md.agbedus.com
NEXT_PUBLIC_BASE_URL_LOCAL=http://127.0.0.1:8000
NEXT_PUBLIC_BASE_URL_PRODUCTION=https://md.agbedus.com
